+/**
+ * GstMLQnnHtpPerformanceMode:
+ * @GST_ML_QNN_HTP_PERFORMANCE_MODE_DEFAULT:             Leave HTP DCVS settings untouched.
+ *
+ * @GST_ML_QNN_HTP_PERFORMANCE_MODE_EXTREME_POWER_SAVER:  Lowest performing, highest power
+ *     savings mode.
+ * @GST_ML_QNN_HTP_PERFORMANCE_MODE_LOW_POWER_SAVER:      Lower clocks than power saver.
+ * @GST_ML_QNN_HTP_PERFORMANCE_MODE_POWER_SAVER:          Power sensitive, at the expense of
+ *     performance.
+ * @GST_ML_QNN_HTP_PERFORMANCE_MODE_HIGH_POWER_SAVER:     Higher clocks than power saver.
+ * @GST_ML_QNN_HTP_PERFORMANCE_MODE_LOW_BALANCED:         Lower clocks than balanced.
+ * @GST_ML_QNN_HTP_PERFORMANCE_MODE_BALANCED:             Balanced performance and power.
+ * @GST_ML_QNN_HTP_PERFORMANCE_MODE_HIGH_PERFORMANCE:     High performance, relaxes between
+ *     inferences to save power.
+ * @GST_ML_QNN_HTP_PERFORMANCE_MODE_SUSTAINED_HIGH_PERFORMANCE:
+ *     High performance, sustained across inferences.
+ * @GST_ML_QNN_HTP_PERFORMANCE_MODE_BURST:                Maximum performance, sustained.
+ *
+ * HTP DCVS performance modes, as defined in the QNN HTP backend documentation. Each mode
+ * configures a distinct combination of core/bus voltage corners, sleep latency and RPC
+ * polling behavior.
+ */
+typedef enum {
+  GST_ML_QNN_HTP_PERFORMANCE_MODE_DEFAULT,
+  GST_ML_QNN_HTP_PERFORMANCE_MODE_EXTREME_POWER_SAVER,
+  GST_ML_QNN_HTP_PERFORMANCE_MODE_LOW_POWER_SAVER,
+  GST_ML_QNN_HTP_PERFORMANCE_MODE_POWER_SAVER,
+  GST_ML_QNN_HTP_PERFORMANCE_MODE_HIGH_POWER_SAVER,
+  GST_ML_QNN_HTP_PERFORMANCE_MODE_LOW_BALANCED,
+  GST_ML_QNN_HTP_PERFORMANCE_MODE_BALANCED,
+  GST_ML_QNN_HTP_PERFORMANCE_MODE_HIGH_PERFORMANCE,
+  GST_ML_QNN_HTP_PERFORMANCE_MODE_SUSTAINED_HIGH_PERFORMANCE,
+  GST_ML_QNN_HTP_PERFORMANCE_MODE_BURST,
+} GstMLQnnHtpPerformanceMode;
