+{
+  static GType gtype = 0;
+  static const GEnumValue variants[] = {
+    { GST_ML_QNN_HTP_PERFORMANCE_MODE_DEFAULT,
+        "Leave HTP DCVS settings untouched", "default"
+    },
+    { GST_ML_QNN_HTP_PERFORMANCE_MODE_EXTREME_POWER_SAVER,
+        "Lowest performing, highest power savings mode", "extreme-power-saver"
+    },
+    { GST_ML_QNN_HTP_PERFORMANCE_MODE_LOW_POWER_SAVER,
+        "Lower clocks than power saver", "low-power-saver"
+    },
+    { GST_ML_QNN_HTP_PERFORMANCE_MODE_POWER_SAVER,
+        "Power sensitive, at the expense of performance", "power-saver"
+    },
+    { GST_ML_QNN_HTP_PERFORMANCE_MODE_HIGH_POWER_SAVER,
+        "Higher clocks than power saver", "high-power-saver"
+    },
+    { GST_ML_QNN_HTP_PERFORMANCE_MODE_LOW_BALANCED,
+        "Lower clocks than balanced", "low-balanced"
+    },
+    { GST_ML_QNN_HTP_PERFORMANCE_MODE_BALANCED,
+        "Balanced performance and power", "balanced"
+    },
+    { GST_ML_QNN_HTP_PERFORMANCE_MODE_HIGH_PERFORMANCE,
+        "High performance", "high-performance"
+    },
+    { GST_ML_QNN_HTP_PERFORMANCE_MODE_SUSTAINED_HIGH_PERFORMANCE,
+        "High performance, sustained", "sustained-high-performance"
+    },
+    { GST_ML_QNN_HTP_PERFORMANCE_MODE_BURST,
+        "Maximum performance, sustained", "burst"
+    },
+    {0, NULL, NULL},
+  };
+
+  if (!gtype)
+    gtype = g_enum_register_static ("GstMLQnnHtpPerformanceMode", variants);
+
+  return gtype;
+}
