diff --git a/gst-sample-apps/gst-ai-multistream-detection-classification/main.c b/gst-sample-apps/gst-ai-multistream-detection-classification/main.c
new file mode 100644
index 0000000..2252dcc
--- /dev/null
+++ b/gst-sample-apps/gst-ai-multistream-detection-classification/main.c
@@ -0,0 +1,1385 @@
+/*
+ * Copyright (c) Qualcomm Technologies, Inc. and/or its subsidiaries.
+ * SPDX-License-Identifier: BSD-3-Clause-Clear
+ */
+
+/**
+ * Application:
+ * AI based Multi Stream daisy-chained inference on RTSP or MP4 inputs.
+ *
+ * Description:
+ * Each input stream is decoded and processed through two sequential
+ * inference stages, each merging its result before the next stage runs:
+ *   Stage 1: YOLOX detection on the full frame -> qtimetamux1
+ *   Stage 2: ResNet50 classification on stage 1 ROIs
+ *            (qtimlvconverter mode=roi-batch-cumulative) -> qtimetamux2
+ *
+ * qtimetamux1 attaches detection results to the original video buffer before
+ * stage 2 runs on it; qtimetamux2 attaches classification results on top.
+ * The result is rendered by qtivoverlay, then split into a video branch
+ * (encoded and sent to qtirtspbin or mp4mux + filesink) and, for RTSP output,
+ * a metadata branch (qtimlmetaparser -> qtirtspbin) as selected from the
+ * JSON configuration.
+ */
+
+#include <stdio.h>
+#include <glib-unix.h>
+#include <gst/gst.h>
+#include <glib.h>
+#include <json-glib/json-glib.h>
+
+#include <gst_sample_apps_utils.h>
+
+#define DEFAULT_QNN_YOLOX_MODEL "/root/models/yolox.dlc"
+#define DEFAULT_YOLOX_LABELS "/root/labels/yolox.json"
+#define DEFAULT_QNN_RESNET50_MODEL "/root/models/resnet50.dlc"
+#define DEFAULT_CLASSIFICATION_LABELS "/root/labels/resnet50.json"
+#define DEFAULT_QNN_BACKEND "/usr/lib/libQnnHtp.so"
+
+#define MAX_INPUTS 16
+#define QUEUE_COUNT 13
+#define DEFAULT_THRESHOLD_VALUE 51.0
+
+#define DEFAULT_IP "0.0.0.0"
+#define DEFAULT_PORT "8900"
+#define DEFAULT_INPUT_TYPE "rtsp"
+#define DEFAULT_OUTPUT_TYPE "rtsp"
+#define DEFAULT_NPU0_RATIO 100
+#define DEFAULT_NPU1_RATIO 0
+
+#define DEFAULT_HTP_PERFORMANCE_MODE NULL
+
+#define DEFAULT_CONFIG_FILE "/etc/configs/config-multistream-detection-classification.json"
+
+/**
+ * Runtime options loaded from config-multistream-detection-classification.json.
+ *
+ * Input paths remain arrays so additional RTSP streams or MP4 files can be
+ * enabled without changing the pipeline construction code. A complete,
+ * independent pipeline is created for every configured input.
+ */
+typedef struct {
+  gchar *detection_model_path;
+  gchar *detection_labels_path;
+  gchar *classification_model_path;
+  gchar *classification_labels_path;
+  gchar *ip_address;
+  gchar *port_num;
+  gchar *input_type;
+  gchar *output_type;
+  gint npu0_ratio;
+  gint npu1_ratio;
+  gint input_count;
+  gchar *input_rtsp_path[MAX_INPUTS];
+  gchar *input_file_path[MAX_INPUTS];
+  gchar *output_file_path[MAX_INPUTS];
+  gchar *htp_performance_mode;
+} GstAppOptions;
+
+/**
+ * Detect how many CDSP/HTP backends are available on the target.
+ *
+ * When two backends are present, detection and classification are distributed
+ * between them in create_pipe() to avoid forcing both models onto one backend.
+ */
+static gint
+get_num_cdsp_backends ()
+{
+  gint num_cdsp_backends = 1;
+
+  if (access ("/dev/fastrpc-cdsp1", F_OK) == 0)
+    num_cdsp_backends = 2;
+
+  return num_cdsp_backends;
+}
+
+/**
+ * Configure one QNN inference element and its matching post-process element.
+ *
+ * Both models run on the QNN HTP backend. The detection model additionally
+ * needs its output tensors named explicitly since qtimlqnn cannot infer them
+ * from a .dlc file. The post-processing module is selected by use_case:
+ * YOLO-style processing for object detection and softmax classification
+ * processing for ResNet50.
+ */
+static gboolean
+set_ml_params (GstElement * qtimlelement, GstElement * qtimlpostprocess,
+    const gchar * model_path, const gchar * labels_path, gint use_case,
+    guint htp_id, const gchar * htp_performance_mode)
+{
+  gint module_id;
+  const gchar *module = NULL;
+  gchar settings[128];
+
+  g_object_set (G_OBJECT (qtimlelement), "model", model_path,
+      "backend", DEFAULT_QNN_BACKEND, "backend-device-id", htp_id, NULL);
+
+  if (htp_performance_mode) {
+    gint perf_mode = get_enum_value (
+        qtimlelement,
+        "htp-performance-mode",
+        htp_performance_mode);
+
+    if (perf_mode == -1) {
+      g_printerr ("Invalid htp-performance-mode: %s\n", htp_performance_mode);
+      return FALSE;
+    }
+
+    g_object_set (G_OBJECT (qtimlelement),
+        "htp-performance-mode",
+        perf_mode,
+        NULL);
+  }
+
+  if (use_case == GST_OBJECT_DETECTION) {
+    GValue tensors = G_VALUE_INIT;
+    GValue value = G_VALUE_INIT;
+    const gchar *tensor_names[] = { "boxes", "scores", "class_idx" };
+
+    g_value_init (&tensors, GST_TYPE_ARRAY);
+    g_value_init (&value, G_TYPE_STRING);
+    for (guint i = 0; i < G_N_ELEMENTS (tensor_names); i++) {
+      g_value_set_string (&value, tensor_names[i]);
+      gst_value_array_append_value (&tensors, &value);
+    }
+    g_object_set_property (G_OBJECT (qtimlelement), "tensors", &tensors);
+    g_value_unset (&value);
+    g_value_unset (&tensors);
+  }
+
+  g_object_set (G_OBJECT (qtimlpostprocess), "labels", labels_path, NULL);
+
+  if (use_case == GST_OBJECT_DETECTION) {
+    module = "yolov8";
+  } else if (use_case == GST_CLASSIFICATION) {
+    module = "mobilenet";
+  }
+
+  module_id = get_enum_value (qtimlpostprocess, "module", module);
+  if (module_id == -1) {
+    g_printerr ("Module %s is not available in qtimlpostprocess\n", module);
+    return FALSE;
+  }
+
+  snprintf (settings, 127, "{\"confidence\": %.1f}", DEFAULT_THRESHOLD_VALUE);
+  g_object_set (G_OBJECT (qtimlpostprocess), "module", module_id,
+      "settings", settings, NULL);
+
+  return TRUE;
+}
+
+/**
+ * Handle a dynamic video source pad.
+ *
+ * Both rtspsrc and qtdemux expose their video source pad dynamically. The same
+ * callback is used for both input modes and connects only the video pad to the
+ * first queue of the corresponding stream.
+ */
+static void
+on_pad_added (GstElement * element, GstPad * pad, gpointer data)
+{
+  GstPad *sinkpad = NULL;
+  gchar *caps_str = NULL;
+  GstElement *queue = (GstElement *) data;
+  GstCaps *caps = gst_pad_get_current_caps (pad);
+
+  if (!caps)
+    caps = gst_pad_query_caps (pad, NULL);
+
+  if (caps) {
+    caps_str = gst_caps_to_string (caps);
+  } else {
+    g_print ("No caps available for this pad\n");
+  }
+
+  if (caps_str) {
+    if (g_strrstr (caps_str, "video")) {
+      sinkpad = gst_element_get_static_pad (queue, "sink");
+      if (sinkpad && !gst_pad_is_linked (sinkpad)) {
+        if (gst_pad_link (pad, sinkpad) != GST_PAD_LINK_OK)
+          g_printerr ("Failed to link dynamic source pad\n");
+      }
+      if (sinkpad)
+        gst_object_unref (sinkpad);
+    } else {
+      g_print ("Ignoring non-video source pad\n");
+    }
+  }
+
+  g_free (caps_str);
+  if (caps)
+    gst_caps_unref (caps);
+}
+
+/**
+ * Release application-owned resources and dynamically allocated config values.
+ */
+static void
+gst_app_context_free
+(GstAppContext * appctx, GstAppOptions * options, gchar * config_file)
+{
+  if (appctx->mloop != NULL) {
+    g_main_loop_unref (appctx->mloop);
+    appctx->mloop = NULL;
+  }
+
+  if (options->detection_model_path != NULL &&
+      options->detection_model_path != (gchar *) DEFAULT_QNN_YOLOX_MODEL) {
+    g_free (options->detection_model_path);
+    options->detection_model_path = NULL;
+  }
+
+  if (options->detection_labels_path != NULL &&
+      options->detection_labels_path != (gchar *) DEFAULT_YOLOX_LABELS) {
+    g_free (options->detection_labels_path);
+    options->detection_labels_path = NULL;
+  }
+
+  if (options->classification_model_path != NULL &&
+      options->classification_model_path != (gchar *) DEFAULT_QNN_RESNET50_MODEL) {
+    g_free (options->classification_model_path);
+    options->classification_model_path = NULL;
+  }
+
+  if (options->classification_labels_path != NULL &&
+      options->classification_labels_path != (gchar *) DEFAULT_CLASSIFICATION_LABELS) {
+    g_free (options->classification_labels_path);
+    options->classification_labels_path = NULL;
+  }
+
+  if (options->ip_address != NULL &&
+      options->ip_address != (gchar *) DEFAULT_IP) {
+    g_free (options->ip_address);
+    options->ip_address = NULL;
+  }
+
+  if (options->port_num != NULL &&
+      options->port_num != (gchar *) DEFAULT_PORT) {
+    g_free (options->port_num);
+    options->port_num = NULL;
+  }
+
+  if (options->input_type != NULL &&
+      options->input_type != (gchar *) DEFAULT_INPUT_TYPE) {
+    g_free (options->input_type);
+    options->input_type = NULL;
+  }
+
+  if (options->output_type != NULL &&
+      options->output_type != (gchar *) DEFAULT_OUTPUT_TYPE) {
+    g_free (options->output_type);
+    options->output_type = NULL;
+  }
+
+  if (config_file != NULL &&
+      config_file != (gchar *) DEFAULT_CONFIG_FILE) {
+    g_free (config_file);
+    config_file = NULL;
+  }
+
+  if (options->htp_performance_mode != NULL &&
+    options->htp_performance_mode != (gchar *) DEFAULT_HTP_PERFORMANCE_MODE) {
+    g_free (options->htp_performance_mode);
+    options->htp_performance_mode = NULL;
+  }
+
+  for (gint i = 0; i < options->input_count; i++) {
+    g_free (options->input_rtsp_path[i]);
+    options->input_rtsp_path[i] = NULL;
+    g_free (options->input_file_path[i]);
+    options->input_file_path[i] = NULL;
+    g_free (options->output_file_path[i]);
+    options->output_file_path[i] = NULL;
+  }
+
+  if (appctx->pipeline != NULL) {
+    gst_object_unref (appctx->pipeline);
+    appctx->pipeline = NULL;
+  }
+}
+
+/**
+ * Build one complete processing chain for every configured input.
+ *
+ * Input path:
+ *   RTSP: rtspsrc -> queue -> rtph264depay -> h264parse -> decoder
+ *   MP4:  filesrc -> qtdemux -> queue -> h264parse -> decoder
+ *
+ * Common path (daisy-chained inference stages):
+ *   decoder -> tee1
+ *                |-> original video --------------------------|
+ *                |-> YOLOX detection ---------------------------> qtimetamux1 -> tee2
+ *                                                                                  |-> original video --------------------|
+ *                                                                                  |-> ResNet50 classification -----------> qtimetamux2 -> qtivoverlay -> out_tee
+ *                                                                                       (roi-batch-cumulative on
+ *                                                                                        qtimetamux1 detections)
+ *
+ *   out_tee -> video branch -> encoder -> RTSP/MP4 sink
+ *   out_tee -> qtimlmetaparser -> qtirtspbin metadata sink (RTSP output only)
+ *
+ * Output path:
+ *   RTSP: h264parse -> qtirtspbin (video) + qtimlmetaparser -> qtirtspbin (metadata)
+ *   MP4:  fpsdisplaysink (video-sink: encoder -> h264parse -> mp4mux -> filesink)
+ */
+static gboolean
+create_pipe (GstAppContext * appctx, GstAppOptions * options, guint htp_count)
+{
+  GstElement *rtspsrc[options->input_count];
+  GstElement *filesrc[options->input_count];
+  GstElement *qtdemux[options->input_count];
+  GstElement *rtph_depay[options->input_count];
+
+  GstElement *stream_queue[options->input_count][QUEUE_COUNT];
+  GstElement *dec_parse[options->input_count];
+  GstElement *v4l2_dec[options->input_count];
+  GstElement *decode_caps[options->input_count];
+  GstElement *dec_tee[options->input_count];
+
+  GstElement *detection_qtimlvconverter[options->input_count];
+  GstElement *detection_qtimlelement[options->input_count];
+  GstElement *detection_qtimlpostprocess[options->input_count];
+  GstElement *detection_filter[options->input_count];
+  GstElement *qtimetamux1[options->input_count];
+  GstElement *meta1_tee[options->input_count];
+
+  GstElement *classification_qtimlvconverter[options->input_count];
+  GstElement *classification_qtimlelement[options->input_count];
+  GstElement *classification_qtimlpostprocess[options->input_count];
+  GstElement *classification_filter[options->input_count];
+  GstElement *qtimetamux2[options->input_count];
+
+  GstElement *qtivoverlay[options->input_count];
+  GstElement *out_tee[options->input_count];
+  GstElement *fpsdisplaysink[options->input_count];
+  GstElement *v4l2_encoder[options->input_count];
+  GstElement *encoder_parse[options->input_count];
+  GstElement *qtimlmetaparser[options->input_count];
+
+  GstElement *qtirtspbin[options->input_count];
+  GstElement *mp4mux[options->input_count];
+  GstElement *filesink[options->input_count];
+
+  GstCaps *filtercaps = NULL;
+  GstStructure *fcontrols = NULL;
+  gchar element_name[128];
+  gboolean ret = FALSE;
+  gboolean input_is_rtsp =
+      (g_ascii_strcasecmp (options->input_type, "rtsp") == 0);
+  gboolean output_is_rtsp =
+      (g_ascii_strcasecmp (options->output_type, "rtsp") == 0);
+
+  g_print ("IN Options: type=%s count=%d\n",
+      options->input_type, options->input_count);
+  g_print ("OUT Options: type=%s\n", options->output_type);
+
+  for (gint i = 0; i < options->input_count; i++) {
+    rtspsrc[i] = NULL;
+    filesrc[i] = NULL;
+    qtdemux[i] = NULL;
+    rtph_depay[i] = NULL;
+    dec_parse[i] = NULL;
+    v4l2_dec[i] = NULL;
+    decode_caps[i] = NULL;
+    dec_tee[i] = NULL;
+    detection_qtimlvconverter[i] = NULL;
+    detection_qtimlelement[i] = NULL;
+    detection_qtimlpostprocess[i] = NULL;
+    detection_filter[i] = NULL;
+    qtimetamux1[i] = NULL;
+    meta1_tee[i] = NULL;
+    classification_qtimlvconverter[i] = NULL;
+    classification_qtimlelement[i] = NULL;
+    classification_qtimlpostprocess[i] = NULL;
+    classification_filter[i] = NULL;
+    qtimetamux2[i] = NULL;
+    qtivoverlay[i] = NULL;
+    out_tee[i] = NULL;
+    fpsdisplaysink[i] = NULL;
+    v4l2_encoder[i] = NULL;
+    encoder_parse[i] = NULL;
+    qtimlmetaparser[i] = NULL;
+    qtirtspbin[i] = NULL;
+    mp4mux[i] = NULL;
+    filesink[i] = NULL;
+
+    for (gint j = 0; j < QUEUE_COUNT; j++)
+      stream_queue[i][j] = NULL;
+  }
+
+  /*
+   * 1. Create all elements for every input.
+   */
+  for (gint i = 0; i < options->input_count; i++) {
+    if (input_is_rtsp) {
+      snprintf (element_name, 127, "rtspsrc-%d", i);
+      rtspsrc[i] = gst_element_factory_make ("rtspsrc", element_name);
+      if (!rtspsrc[i]) {
+        g_printerr ("Failed to create rtspsrc-%d\n", i);
+        goto error_clean_elements;
+      }
+
+      snprintf (element_name, 127, "rtp_depay-%d", i);
+      rtph_depay[i] = gst_element_factory_make ("rtph264depay", element_name);
+      if (!rtph_depay[i]) {
+        g_printerr ("Failed to create rtp_depay-%d\n", i);
+        goto error_clean_elements;
+      }
+    } else {
+      snprintf (element_name, 127, "filesrc-%d", i);
+      filesrc[i] = gst_element_factory_make ("filesrc", element_name);
+      if (!filesrc[i]) {
+        g_printerr ("Failed to create filesrc-%d\n", i);
+        goto error_clean_elements;
+      }
+
+      snprintf (element_name, 127, "qtdemux-%d", i);
+      qtdemux[i] = gst_element_factory_make ("qtdemux", element_name);
+      if (!qtdemux[i]) {
+        g_printerr ("Failed to create qtdemux-%d\n", i);
+        goto error_clean_elements;
+      }
+    }
+
+    for (gint j = 0; j < QUEUE_COUNT; j++) {
+      snprintf (element_name, 127, "stream_queue-%d-%d", i, j);
+      stream_queue[i][j] = gst_element_factory_make ("queue", element_name);
+      if (!stream_queue[i][j]) {
+        g_printerr ("Failed to create stream_queue-%d-%d\n", i, j);
+        goto error_clean_elements;
+      }
+    }
+
+    snprintf (element_name, 127, "dec_parse-%d", i);
+    dec_parse[i] = gst_element_factory_make ("h264parse", element_name);
+    if (!dec_parse[i]) {
+      g_printerr ("Failed to create dec_parse-%d\n", i);
+      goto error_clean_elements;
+    }
+
+    snprintf (element_name, 127, "v4l2_dec-%d", i);
+    v4l2_dec[i] = gst_element_factory_make ("v4l2h264dec", element_name);
+    if (!v4l2_dec[i]) {
+      g_printerr ("Failed to create v4l2_dec-%d\n", i);
+      goto error_clean_elements;
+    }
+
+    snprintf (element_name, 127, "decode_caps-%d", i);
+    decode_caps[i] = gst_element_factory_make ("capsfilter", element_name);
+    if (!decode_caps[i]) {
+      g_printerr ("Failed to create decode_caps-%d\n", i);
+      goto error_clean_elements;
+    }
+
+    snprintf (element_name, 127, "dec_tee-%d", i);
+    dec_tee[i] = gst_element_factory_make ("tee", element_name);
+    if (!dec_tee[i]) {
+      g_printerr ("Failed to create dec_tee-%d\n", i);
+      goto error_clean_elements;
+    }
+
+    snprintf (element_name, 127, "detection_qtimlvconverter-%d", i);
+    detection_qtimlvconverter[i] = gst_element_factory_make (
+        "qtimlvconverter", element_name);
+    if (!detection_qtimlvconverter[i]) {
+      g_printerr ("Failed to create detection_qtimlvconverter-%d\n", i);
+      goto error_clean_elements;
+    }
+
+    snprintf (element_name, 127, "detection_qtimlelement-%d", i);
+    detection_qtimlelement[i] = gst_element_factory_make (
+        "qtimlqnn", element_name);
+    if (!detection_qtimlelement[i]) {
+      g_printerr ("Failed to create detection_qtimlelement-%d\n", i);
+      goto error_clean_elements;
+    }
+
+    snprintf (element_name, 127, "detection_qtimlpostprocess-%d", i);
+    detection_qtimlpostprocess[i] = gst_element_factory_make (
+        "qtimlpostprocess", element_name);
+    if (!detection_qtimlpostprocess[i]) {
+      g_printerr ("Failed to create detection_qtimlpostprocess-%d\n", i);
+      goto error_clean_elements;
+    }
+
+    snprintf (element_name, 127, "detection_filter-%d", i);
+    detection_filter[i] = gst_element_factory_make (
+        "capsfilter", element_name);
+    if (!detection_filter[i]) {
+      g_printerr ("Failed to create detection_filter-%d\n", i);
+      goto error_clean_elements;
+    }
+
+    snprintf (element_name, 127, "qtimetamux1-%d", i);
+    qtimetamux1[i] = gst_element_factory_make ("qtimetamux", element_name);
+    if (!qtimetamux1[i]) {
+      g_printerr ("Failed to create qtimetamux1-%d\n", i);
+      goto error_clean_elements;
+    }
+
+    snprintf (element_name, 127, "meta1_tee-%d", i);
+    meta1_tee[i] = gst_element_factory_make ("tee", element_name);
+    if (!meta1_tee[i]) {
+      g_printerr ("Failed to create meta1_tee-%d\n", i);
+      goto error_clean_elements;
+    }
+
+    snprintf (element_name, 127, "classification_qtimlvconverter-%d", i);
+    classification_qtimlvconverter[i] = gst_element_factory_make (
+        "qtimlvconverter", element_name);
+    if (!classification_qtimlvconverter[i]) {
+      g_printerr ("Failed to create classification_qtimlvconverter-%d\n", i);
+      goto error_clean_elements;
+    }
+
+    gst_element_set_enum_property (classification_qtimlvconverter[i],
+        "mode", "roi-batch-cumulative");
+
+    snprintf (element_name, 127, "classification_qtimlelement-%d", i);
+    classification_qtimlelement[i] = gst_element_factory_make (
+        "qtimlqnn", element_name);
+    if (!classification_qtimlelement[i]) {
+      g_printerr ("Failed to create classification_qtimlelement-%d\n", i);
+      goto error_clean_elements;
+    }
+
+    snprintf (element_name, 127, "classification_qtimlpostprocess-%d", i);
+    classification_qtimlpostprocess[i] = gst_element_factory_make (
+        "qtimlpostprocess", element_name);
+    if (!classification_qtimlpostprocess[i]) {
+      g_printerr ("Failed to create classification_qtimlpostprocess-%d\n", i);
+      goto error_clean_elements;
+    }
+
+    snprintf (element_name, 127, "classification_filter-%d", i);
+    classification_filter[i] = gst_element_factory_make (
+        "capsfilter", element_name);
+    if (!classification_filter[i]) {
+      g_printerr ("Failed to create classification_filter-%d\n", i);
+      goto error_clean_elements;
+    }
+
+    snprintf (element_name, 127, "qtimetamux2-%d", i);
+    qtimetamux2[i] = gst_element_factory_make ("qtimetamux", element_name);
+    if (!qtimetamux2[i]) {
+      g_printerr ("Failed to create qtimetamux2-%d\n", i);
+      goto error_clean_elements;
+    }
+
+    snprintf (element_name, 127, "qtivoverlay-%d", i);
+    qtivoverlay[i] = gst_element_factory_make ("qtivoverlay", element_name);
+    if (!qtivoverlay[i]) {
+      g_printerr ("Failed to create qtivoverlay-%d\n", i);
+      goto error_clean_elements;
+    }
+
+    snprintf (element_name, 127, "out_tee-%d", i);
+    out_tee[i] = gst_element_factory_make ("tee", element_name);
+    if (!out_tee[i]) {
+      g_printerr ("Failed to create out_tee-%d\n", i);
+      goto error_clean_elements;
+    }
+
+    snprintf (element_name, 127, "v4l2_encoder-%d", i);
+    v4l2_encoder[i] = gst_element_factory_make ("v4l2h264enc", element_name);
+    if (!v4l2_encoder[i]) {
+      g_printerr ("Failed to create v4l2_encoder-%d\n", i);
+      goto error_clean_elements;
+    }
+
+    snprintf (element_name, 127, "encoder_parse-%d", i);
+    encoder_parse[i] = gst_element_factory_make ("h264parse", element_name);
+    if (!encoder_parse[i]) {
+      g_printerr ("Failed to create encoder_parse-%d\n", i);
+      goto error_clean_elements;
+    }
+
+    if (output_is_rtsp) {
+      snprintf (element_name, 127, "qtirtspbin-%d", i);
+      qtirtspbin[i] = gst_element_factory_make ("qtirtspbin", element_name);
+      if (!qtirtspbin[i]) {
+        g_printerr ("Failed to create qtirtspbin-%d\n", i);
+        goto error_clean_elements;
+      }
+
+      snprintf (element_name, 127, "qtimlmetaparser-%d", i);
+      qtimlmetaparser[i] = gst_element_factory_make (
+          "qtimlmetaparser", element_name);
+      if (!qtimlmetaparser[i]) {
+        g_printerr ("Failed to create qtimlmetaparser-%d\n", i);
+        goto error_clean_elements;
+      }
+    } else {
+      snprintf (element_name, 127, "fpsdisplaysink-%d", i);
+      fpsdisplaysink[i] = gst_element_factory_make ("fpsdisplaysink", element_name);
+      if (!fpsdisplaysink[i]) {
+        g_printerr ("Failed to create fpsdisplaysink-%d\n", i);
+        goto error_clean_elements;
+      }
+
+      snprintf (element_name, 127, "mp4mux-%d", i);
+      mp4mux[i] = gst_element_factory_make ("mp4mux", element_name);
+      if (!mp4mux[i]) {
+        g_printerr ("Failed to create mp4mux-%d\n", i);
+        goto error_clean_elements;
+      }
+
+      snprintf (element_name, 127, "filesink-%d", i);
+      filesink[i] = gst_element_factory_make ("filesink", element_name);
+      if (!filesink[i]) {
+        g_printerr ("Failed to create filesink-%d\n", i);
+        goto error_clean_elements;
+      }
+    }
+  }
+
+  /*
+   * 2. Configure source, decoder, inference, encoder and output.
+   */
+  for (gint i = 0; i < options->input_count; i++) {
+    if (input_is_rtsp) {
+      g_object_set (G_OBJECT (rtspsrc[i]), "location",
+          options->input_rtsp_path[i], NULL);
+    } else {
+      g_object_set (G_OBJECT (filesrc[i]), "location",
+          options->input_file_path[i], NULL);
+    }
+
+    gst_element_set_enum_property (v4l2_dec[i], "capture-io-mode",
+        "dmabuf");
+    gst_element_set_enum_property (v4l2_dec[i], "output-io-mode",
+        "dmabuf");
+
+    filtercaps = gst_caps_new_simple ("video/x-raw",
+        "format", G_TYPE_STRING, "NV12_Q08C", NULL);
+    g_object_set (G_OBJECT (decode_caps[i]), "caps", filtercaps, NULL);
+    gst_caps_unref (filtercaps);
+
+    /*
+     * Distribute ML workloads between the two HTP/NPU devices using the
+     * configured ratio. The modulo pattern keeps the assignments interleaved
+     * instead of filling one NPU first and the other afterwards.
+     *
+     * With 60/40, every 10 inference workloads are distributed 6 to NPU0
+     * and 4 to NPU1. If only one HTP backend is available, both models use 0.
+     */
+    guint detection_htp_id = 0;
+    guint classification_htp_id = 0;
+
+    if (htp_count > 1) {
+      guint detection_workload = i * 2;
+      guint classification_workload = i * 2 + 1;
+
+      detection_htp_id =
+          ((detection_workload * options->npu0_ratio) % 100 <
+          (guint) options->npu0_ratio) ? 0 : 1;
+      classification_htp_id =
+          ((classification_workload * options->npu0_ratio) % 100 <
+          (guint) options->npu0_ratio) ? 0 : 1;
+    }
+
+    g_print ("Stream %d NPU assignment: detection=NPU%u, "
+        "classification=NPU%u\n", i, detection_htp_id,
+        classification_htp_id);
+
+    if (!set_ml_params (detection_qtimlelement[i], detection_qtimlpostprocess[i],
+        options->detection_model_path, options->detection_labels_path,
+        GST_OBJECT_DETECTION, detection_htp_id, options->htp_performance_mode)) {
+      goto error_clean_elements;
+    }
+
+    if (!set_ml_params (classification_qtimlelement[i],
+        classification_qtimlpostprocess[i],
+        options->classification_model_path, options->classification_labels_path,
+        GST_CLASSIFICATION, classification_htp_id, options->htp_performance_mode)) {
+      goto error_clean_elements;
+    }
+
+    filtercaps = gst_caps_new_simple ("text/x-raw",
+        "format", G_TYPE_STRING, "utf8", NULL);
+    g_object_set (G_OBJECT (detection_filter[i]), "caps", filtercaps, NULL);
+    g_object_set (G_OBJECT (classification_filter[i]), "caps", filtercaps,
+        NULL);
+    gst_caps_unref (filtercaps);
+
+    gst_element_set_enum_property (v4l2_encoder[i], "capture-io-mode",
+        "dmabuf");
+    gst_element_set_enum_property (v4l2_encoder[i], "output-io-mode",
+        "dmabuf-import");
+
+    fcontrols = gst_structure_from_string (
+        "fcontrols,video_bitrate=6000000,video_bitrate_mode=0", NULL);
+    g_object_set (G_OBJECT (v4l2_encoder[i]), "extra-controls", fcontrols,
+        NULL);
+    gst_structure_free (fcontrols);
+    fcontrols = NULL;
+
+    g_object_set (G_OBJECT (encoder_parse[i]), "config-interval", 1, NULL);
+
+    if (output_is_rtsp) {
+      gchar port_num[16];
+      gint port = atoi (options->port_num) + i;
+
+      snprintf (port_num, sizeof (port_num), "%d", port);
+      g_print ("RTSP output %d: ip=%s port=%s\n", i,
+          options->ip_address, port_num);
+      g_object_set (G_OBJECT (qtirtspbin[i]), "address", options->ip_address,
+          "port", port_num, NULL);
+
+      gst_element_set_enum_property (qtimlmetaparser[i], "module", "json");
+    } else {
+      GstElement *file_video_sink = NULL;
+      GstPad *encoder_sink_pad = NULL;
+      GstPad *ghost_sink_pad = NULL;
+
+      g_print ("MP4 output %d: %s\n", i, options->output_file_path[i]);
+      g_object_set (G_OBJECT (filesink[i]), "location",
+          options->output_file_path[i], "sync", FALSE, NULL);
+
+      snprintf (element_name, 127, "file-video-sink-%d", i);
+      file_video_sink = gst_bin_new (element_name);
+      if (!file_video_sink) {
+        g_printerr ("Failed to create file-video-sink-%d\n", i);
+        goto error_clean_elements;
+      }
+
+      gst_bin_add_many (GST_BIN (file_video_sink),
+          v4l2_encoder[i], encoder_parse[i], mp4mux[i], filesink[i], NULL);
+
+      if (!gst_element_link_many (v4l2_encoder[i], encoder_parse[i],
+              mp4mux[i], filesink[i], NULL)) {
+        g_printerr ("Failed to link file video sink for %d\n", i);
+        gst_object_unref (file_video_sink);
+        v4l2_encoder[i] = NULL;
+        encoder_parse[i] = NULL;
+        mp4mux[i] = NULL;
+        filesink[i] = NULL;
+        goto error_clean_elements;
+      }
+
+      encoder_sink_pad = gst_element_get_static_pad (v4l2_encoder[i], "sink");
+      ghost_sink_pad = gst_ghost_pad_new ("sink", encoder_sink_pad);
+      gst_object_unref (encoder_sink_pad);
+
+      if (!ghost_sink_pad || !gst_element_add_pad (file_video_sink, ghost_sink_pad)) {
+        g_printerr ("Failed to create sink ghost pad for file-video-sink-%d\n", i);
+        if (ghost_sink_pad)
+          gst_object_unref (ghost_sink_pad);
+        gst_object_unref (file_video_sink);
+        v4l2_encoder[i] = NULL;
+        encoder_parse[i] = NULL;
+        mp4mux[i] = NULL;
+        filesink[i] = NULL;
+        goto error_clean_elements;
+      }
+
+      g_object_set (G_OBJECT (fpsdisplaysink[i]),
+          "sync", FALSE,
+          "text-overlay", FALSE,
+          "signal-fps-measurements", TRUE,
+          "video-sink", file_video_sink,
+          NULL);
+      gst_object_unref (file_video_sink);
+
+      /* The file output elements are now owned by fpsdisplaysink's video-sink. */
+      v4l2_encoder[i] = NULL;
+      encoder_parse[i] = NULL;
+      mp4mux[i] = NULL;
+      filesink[i] = NULL;
+    }
+  }
+
+  /*
+   * 3. Add elements to the pipeline.
+   */
+  for (gint i = 0; i < options->input_count; i++) {
+    gst_bin_add_many (GST_BIN (appctx->pipeline),
+        dec_parse[i], v4l2_dec[i], decode_caps[i],
+        dec_tee[i], detection_qtimlvconverter[i], detection_qtimlelement[i],
+        detection_qtimlpostprocess[i], detection_filter[i],
+        qtimetamux1[i], meta1_tee[i],
+        classification_qtimlvconverter[i],
+        classification_qtimlelement[i],
+        classification_qtimlpostprocess[i],
+        classification_filter[i], qtimetamux2[i], qtivoverlay[i],
+        out_tee[i], NULL);
+
+    if (input_is_rtsp)
+      gst_bin_add_many (GST_BIN (appctx->pipeline),
+          rtspsrc[i], rtph_depay[i], NULL);
+    else
+      gst_bin_add_many (GST_BIN (appctx->pipeline),
+          filesrc[i], qtdemux[i], NULL);
+
+    if (output_is_rtsp)
+      gst_bin_add_many (GST_BIN (appctx->pipeline),
+          v4l2_encoder[i], encoder_parse[i], qtirtspbin[i], qtimlmetaparser[i],
+          NULL);
+    else
+      gst_bin_add (GST_BIN (appctx->pipeline), fpsdisplaysink[i]);
+
+    for (gint j = 0; j < QUEUE_COUNT; j++)
+      gst_bin_add (GST_BIN (appctx->pipeline), stream_queue[i][j]);
+  }
+
+  g_print ("Link elements...\n");
+
+  /*
+   * 4. Link the selected source, common ML graph and selected sink.
+   */
+  for (gint i = 0; i < options->input_count; i++) {
+    if (input_is_rtsp) {
+      ret = gst_element_link_many (stream_queue[i][0], rtph_depay[i],
+          dec_parse[i], v4l2_dec[i], decode_caps[i], dec_tee[i], NULL);
+      if (!ret) {
+        g_printerr ("Pipeline elements cannot be linked for %d "
+            "RTSP decode path -> tee.\n", i);
+        goto error_clean_pipeline;
+      }
+
+      g_signal_connect (rtspsrc[i], "pad-added", G_CALLBACK (on_pad_added),
+          stream_queue[i][0]);
+    } else {
+      ret = gst_element_link (filesrc[i], qtdemux[i]);
+      if (!ret) {
+        g_printerr ("Pipeline elements cannot be linked for %d "
+            "filesrc -> qtdemux.\n", i);
+        goto error_clean_pipeline;
+      }
+
+      ret = gst_element_link_many (stream_queue[i][0], dec_parse[i],
+          v4l2_dec[i], decode_caps[i], dec_tee[i], NULL);
+      if (!ret) {
+        g_printerr ("Pipeline elements cannot be linked for %d "
+            "MP4 decode path -> tee.\n", i);
+        goto error_clean_pipeline;
+      }
+
+      g_signal_connect (qtdemux[i], "pad-added", G_CALLBACK (on_pad_added),
+          stream_queue[i][0]);
+    }
+
+    ret = gst_element_link_many (dec_tee[i], stream_queue[i][1],
+        qtimetamux1[i], NULL);
+    if (!ret) {
+      g_printerr ("Pipeline elements cannot be linked for %d "
+          "video branch -> qtimetamux1.\n", i);
+      goto error_clean_pipeline;
+    }
+
+    ret = gst_element_link_many (dec_tee[i], stream_queue[i][2],
+        detection_qtimlvconverter[i], stream_queue[i][3], detection_qtimlelement[i],
+        stream_queue[i][4], detection_qtimlpostprocess[i], detection_filter[i],
+        stream_queue[i][5], qtimetamux1[i], NULL);
+    if (!ret) {
+      g_printerr ("Pipeline elements cannot be linked for %d "
+          "YOLOX inference branch -> qtimetamux1.\n", i);
+      goto error_clean_pipeline;
+    }
+
+    ret = gst_element_link_many (qtimetamux1[i], meta1_tee[i], NULL);
+    if (!ret) {
+      g_printerr ("Pipeline elements cannot be linked for %d "
+          "qtimetamux1 -> tee2.\n", i);
+      goto error_clean_pipeline;
+    }
+
+    ret = gst_element_link_many (meta1_tee[i], stream_queue[i][6],
+        qtimetamux2[i], NULL);
+    if (!ret) {
+      g_printerr ("Pipeline elements cannot be linked for %d "
+          "video branch -> qtimetamux2.\n", i);
+      goto error_clean_pipeline;
+    }
+
+    /*
+     * ResNet50 pre-processing runs in roi-batch-cumulative mode: it reads
+     * the YOLOX detection ROIs attached by qtimetamux1 and classifies each
+     * detected region instead of the whole frame.
+     */
+    ret = gst_element_link_many (meta1_tee[i], stream_queue[i][7],
+        classification_qtimlvconverter[i], stream_queue[i][8],
+        classification_qtimlelement[i], stream_queue[i][9],
+        classification_qtimlpostprocess[i],
+        classification_filter[i], stream_queue[i][10], qtimetamux2[i], NULL);
+    if (!ret) {
+      g_printerr ("Pipeline elements cannot be linked for %d "
+          "ResNet50 inference branch -> qtimetamux2.\n", i);
+      goto error_clean_pipeline;
+    }
+
+    ret = gst_element_link_many (qtimetamux2[i], qtivoverlay[i],
+        out_tee[i], NULL);
+    if (!ret) {
+      g_printerr ("Pipeline elements cannot be linked for %d "
+          "qtimetamux2 -> overlay -> tee3.\n", i);
+      goto error_clean_pipeline;
+    }
+
+    if (output_is_rtsp) {
+      ret = gst_element_link_many (out_tee[i], stream_queue[i][11],
+          v4l2_encoder[i], encoder_parse[i], qtirtspbin[i], NULL);
+      if (!ret) {
+        g_printerr ("Pipeline elements cannot be linked for %d "
+            "overlay -> encoder -> qtirtspbin.\n", i);
+        goto error_clean_pipeline;
+      }
+
+      /* Metadata branch: parsed ROI/classification results are pushed to a
+       * second, independent qtirtspbin request pad alongside the video. */
+      ret = gst_element_link_many (out_tee[i], stream_queue[i][12],
+          qtimlmetaparser[i], qtirtspbin[i], NULL);
+      if (!ret) {
+        g_printerr ("Pipeline elements cannot be linked for %d "
+            "overlay -> qtimlmetaparser -> qtirtspbin.\n", i);
+        goto error_clean_pipeline;
+      }
+    } else {
+      ret = gst_element_link_many (out_tee[i], stream_queue[i][11],
+          fpsdisplaysink[i], NULL);
+      if (!ret) {
+        g_printerr ("Pipeline elements cannot be linked for %d "
+            "overlay -> fpsdisplaysink -> file output.\n", i);
+        goto error_clean_pipeline;
+      }
+    }
+  }
+
+  return TRUE;
+
+error_clean_pipeline:
+  gst_object_unref (appctx->pipeline);
+  appctx->pipeline = NULL;
+  return FALSE;
+
+error_clean_elements:
+  for (gint i = 0; i < options->input_count; i++) {
+    cleanup_gst (&rtspsrc[i], &filesrc[i], &qtdemux[i], &rtph_depay[i],
+        &dec_parse[i], &v4l2_dec[i], &decode_caps[i],
+        &dec_tee[i], &detection_qtimlvconverter[i], &detection_qtimlelement[i],
+        &detection_qtimlpostprocess[i], &detection_filter[i],
+        &qtimetamux1[i], &meta1_tee[i],
+        &classification_qtimlvconverter[i],
+        &classification_qtimlelement[i],
+        &classification_qtimlpostprocess[i],
+        &classification_filter[i], &qtimetamux2[i], &qtivoverlay[i],
+        &out_tee[i], &fpsdisplaysink[i], &v4l2_encoder[i], &encoder_parse[i],
+        &qtimlmetaparser[i], &qtirtspbin[i], &mp4mux[i], &filesink[i], NULL);
+
+    for (gint j = 0; j < QUEUE_COUNT; j++)
+      cleanup_gst (&stream_queue[i][j], NULL);
+  }
+
+  return FALSE;
+}
+
+/**
+ * Parse config-multistream-detection-classification.json.
+ *
+ * input-type and output-type select the source and sink:
+ *   input-type:  "rtsp" or "file"
+ *   output-type: "rtsp" or "file"
+ */
+gint
+parse_json (gchar * config_file, GstAppOptions * options)
+{
+  JsonParser *parser = NULL;
+  JsonNode *root = NULL;
+  JsonObject *root_obj = NULL;
+  JsonArray *input_info = NULL;
+  JsonArray *output_info = NULL;
+  GError *error = NULL;
+
+  parser = json_parser_new ();
+
+  if (!json_parser_load_from_file (parser, config_file, &error)) {
+    g_printerr ("Unable to parse JSON file: %s\n", error->message);
+    g_error_free (error);
+    g_object_unref (parser);
+    return -1;
+  }
+
+  root = json_parser_get_root (parser);
+  if (!JSON_NODE_HOLDS_OBJECT (root)) {
+    gst_printerr ("Failed to load json object\n");
+    g_object_unref (parser);
+    return -1;
+  }
+  root_obj = json_node_get_object (root);
+
+  if (json_object_has_member (root_obj, "input-type"))
+    options->input_type =
+        g_strdup (json_object_get_string_member (root_obj, "input-type"));
+
+  if (json_object_has_member (root_obj, "output-type"))
+    options->output_type =
+        g_strdup (json_object_get_string_member (root_obj, "output-type"));
+
+  /*
+   * Optional weighted NPU distribution. Example:
+   *   "npu-load-ratio": { "npu0": 60, "npu1": 40 }
+   *
+   * The values are percentages and must add up to 100.
+   */
+  if (json_object_has_member (root_obj, "npu-load-ratio")) {
+    JsonObject *npu_ratio =
+        json_object_get_object_member (root_obj, "npu-load-ratio");
+
+    if (json_object_has_member (npu_ratio, "npu0"))
+      options->npu0_ratio = json_object_get_int_member (npu_ratio, "npu0");
+    if (json_object_has_member (npu_ratio, "npu1"))
+      options->npu1_ratio = json_object_get_int_member (npu_ratio, "npu1");
+  }
+
+  if (options->npu0_ratio < 0 || options->npu1_ratio < 0 ||
+      options->npu0_ratio + options->npu1_ratio != 100) {
+    gst_printerr ("Invalid npu-load-ratio: npu0=%d npu1=%d. "
+        "Values must be >= 0 and sum to 100.\n",
+        options->npu0_ratio, options->npu1_ratio);
+    g_object_unref (parser);
+    return -1;
+  }
+
+  if (g_ascii_strcasecmp (options->input_type, "rtsp") == 0) {
+    if (!json_object_has_member (root_obj, "input-rtsp-path")) {
+      gst_printerr ("input-rtsp-path is required when input-type is rtsp\n");
+      g_object_unref (parser);
+      return -1;
+    }
+
+    input_info = json_object_get_array_member (root_obj, "input-rtsp-path");
+    options->input_count = json_array_get_length (input_info);
+    if (options->input_count <= 0 || options->input_count > MAX_INPUTS) {
+      gst_printerr ("Number of inputs has to be between 1 and %d\n",
+          MAX_INPUTS);
+      g_object_unref (parser);
+      return -1;
+    }
+
+    for (gint i = 0; i < options->input_count; i++)
+      options->input_rtsp_path[i] =
+          g_strdup (json_array_get_string_element (input_info, i));
+  } else if (g_ascii_strcasecmp (options->input_type, "file") == 0) {
+    if (!json_object_has_member (root_obj, "input-file-path")) {
+      gst_printerr ("input-file-path is required when input-type is file\n");
+      g_object_unref (parser);
+      return -1;
+    }
+
+    input_info = json_object_get_array_member (root_obj, "input-file-path");
+    options->input_count = json_array_get_length (input_info);
+    if (options->input_count <= 0 || options->input_count > MAX_INPUTS) {
+      gst_printerr ("Number of inputs has to be between 1 and %d\n",
+          MAX_INPUTS);
+      g_object_unref (parser);
+      return -1;
+    }
+
+    for (gint i = 0; i < options->input_count; i++)
+      options->input_file_path[i] =
+          g_strdup (json_array_get_string_element (input_info, i));
+  } else {
+    gst_printerr ("Unsupported input-type: %s. Use rtsp or file.\n",
+        options->input_type);
+    g_object_unref (parser);
+    return -1;
+  }
+
+  if (g_ascii_strcasecmp (options->output_type, "file") == 0) {
+    if (!json_object_has_member (root_obj, "output-file-path")) {
+      gst_printerr ("output-file-path is required when output-type is file\n");
+      g_object_unref (parser);
+      return -1;
+    }
+
+    output_info = json_object_get_array_member (root_obj, "output-file-path");
+    if ((gint) json_array_get_length (output_info) != options->input_count) {
+      gst_printerr ("output-file-path must contain exactly %d entries\n",
+          options->input_count);
+      g_object_unref (parser);
+      return -1;
+    }
+
+    for (gint i = 0; i < options->input_count; i++)
+      options->output_file_path[i] =
+          g_strdup (json_array_get_string_element (output_info, i));
+  } else if (g_ascii_strcasecmp (options->output_type, "rtsp") != 0) {
+    gst_printerr ("Unsupported output-type: %s. Use rtsp or file.\n",
+        options->output_type);
+    g_object_unref (parser);
+    return -1;
+  }
+
+  if (json_object_has_member (root_obj, "detection-model"))
+    options->detection_model_path =
+        g_strdup (json_object_get_string_member (root_obj, "detection-model"));
+
+  if (json_object_has_member (root_obj, "detection-labels"))
+    options->detection_labels_path =
+        g_strdup (json_object_get_string_member (root_obj, "detection-labels"));
+
+  if (json_object_has_member (root_obj, "classification-model"))
+    options->classification_model_path = g_strdup (
+        json_object_get_string_member (root_obj, "classification-model"));
+
+  if (json_object_has_member (root_obj, "classification-labels"))
+    options->classification_labels_path = g_strdup (
+        json_object_get_string_member (root_obj, "classification-labels"));
+
+  if (json_object_has_member (root_obj, "output-ip-address"))
+    options->ip_address =
+        g_strdup (json_object_get_string_member (root_obj, "output-ip-address"));
+
+  if (json_object_has_member (root_obj, "output-port-number")) {
+    JsonNode *port_node = json_object_get_member (root_obj, "output-port-number");
+    if (JSON_NODE_HOLDS_VALUE (port_node) &&
+        json_node_get_value_type (port_node) == G_TYPE_STRING)
+      options->port_num = g_strdup (json_node_get_string (port_node));
+    else
+      options->port_num = g_strdup_printf ("%" G_GINT64_FORMAT,
+          json_node_get_int (port_node));
+  }
+
+  if (json_object_has_member (root_obj, "htp-performance-mode"))
+    options->htp_performance_mode =
+      g_strdup (json_object_get_string_member (
+        root_obj, "htp-performance-mode"));
+
+  g_object_unref (parser);
+  return 0;
+}
+
+/**
+ * Application entry point.
+ *
+ * Loads the JSON configuration, validates model/label paths, builds the
+ * programmatic GStreamer pipeline and runs it until EOS, error or SIGINT.
+ */
+gint
+main (gint argc, gchar * argv[])
+{
+  GMainLoop *mloop = NULL;
+  GstBus *bus = NULL;
+  GstElement *pipeline = NULL;
+  GOptionContext *ctx = NULL;
+  const gchar *app_name = NULL;
+  gchar *config_file = NULL;
+  GstAppContext appctx = {};
+  GstAppOptions options = {};
+  guint intrpt_watch_id = 0;
+  gboolean ret = FALSE;
+  gchar help_description[2048];
+  gint htp_count = 1;
+
+  options.ip_address = DEFAULT_IP;
+  options.port_num = DEFAULT_PORT;
+  options.input_type = DEFAULT_INPUT_TYPE;
+  options.output_type = DEFAULT_OUTPUT_TYPE;
+  options.npu0_ratio = DEFAULT_NPU0_RATIO;
+  options.npu1_ratio = DEFAULT_NPU1_RATIO;
+  options.detection_model_path = DEFAULT_QNN_YOLOX_MODEL;
+  options.detection_labels_path = DEFAULT_YOLOX_LABELS;
+  options.classification_model_path = DEFAULT_QNN_RESNET50_MODEL;
+  options.classification_labels_path = DEFAULT_CLASSIFICATION_LABELS;
+  options.htp_performance_mode = DEFAULT_HTP_PERFORMANCE_MODE;
+
+  /* Detect available HTP backends before assigning the two ML workloads. */
+  htp_count = get_num_cdsp_backends ();
+  g_print ("HTP Core Count = %d\n", htp_count);
+
+  GOptionEntry entries[] = {
+    { "config-file", 0, 0, G_OPTION_ARG_STRING,
+      &config_file,
+      "Path to config file\n",
+      NULL
+    },
+    { NULL }
+  };
+
+  app_name = strrchr (argv[0], '/') ? (strrchr (argv[0], '/') + 1) : argv[0];
+
+  snprintf (help_description, sizeof (help_description) - 1,
+      "\nExample:\n"
+      "  %s --config-file=%s\n"
+      "\nRTSP/MP4 -> YOLOX -> qtimetamux1 -> ResNet50 (per-ROI) -> qtimetamux2 "
+      "-> qtivoverlay -> RTSP/MP4\n"
+      "\nConfig file fields:\n"
+      "  input-type: rtsp or file\n"
+      "  output-type: rtsp or file\n"
+      "  npu-load-ratio: { npu0: 60, npu1: 40 }\n"
+      "  input-rtsp-path: JSON array of RTSP URLs\n"
+      "  input-file-path: JSON array of H.264 MP4 files\n"
+      "  output-file-path: JSON array of output MP4 files\n"
+      "  detection-model: YOLOX QNN model (.dlc)\n"
+      "  detection-labels: YOLOX labels\n"
+      "  classification-model: ResNet50 QNN model (.dlc)\n"
+      "  classification-labels: classification labels\n"
+      "  output-ip-address: RTSP server listening address\n"
+      "  output-port-number: base RTSP port\n",
+      app_name, DEFAULT_CONFIG_FILE);
+
+  if ((ctx = g_option_context_new (help_description)) != NULL) {
+    gboolean success = FALSE;
+    GError *error = NULL;
+
+    g_option_context_add_main_entries (ctx, entries, NULL);
+    g_option_context_add_group (ctx, gst_init_get_option_group ());
+
+    success = g_option_context_parse (ctx, &argc, &argv, &error);
+    g_option_context_free (ctx);
+
+    if (!success) {
+      if (error != NULL) {
+        g_printerr ("Failed to parse command line options: %s!\n",
+            GST_STR_NULL (error->message));
+        g_clear_error (&error);
+      }
+      gst_app_context_free (&appctx, &options, config_file);
+      return -EFAULT;
+    }
+  } else {
+    g_printerr ("Failed to create options context!\n");
+    return -EFAULT;
+  }
+
+  if (config_file == NULL)
+    config_file = DEFAULT_CONFIG_FILE;
+
+  if (!file_exists (config_file)) {
+    g_printerr ("Invalid config file path: %s\n", config_file);
+    gst_app_context_free (&appctx, &options, config_file);
+    return -EINVAL;
+  }
+
+  if (parse_json (config_file, &options) != 0) {
+    gst_app_context_free (&appctx, &options, config_file);
+    return -EINVAL;
+  }
+
+  g_print ("NPU load ratio: NPU0=%d%%, NPU1=%d%%\n",
+      options.npu0_ratio, options.npu1_ratio);
+
+  if (options.input_count <= 0 || options.input_count > MAX_INPUTS) {
+    g_printerr ("Number of inputs must be between 1 and %d\n",
+        MAX_INPUTS);
+    gst_app_context_free (&appctx, &options, config_file);
+    return -EINVAL;
+  }
+
+  if (g_ascii_strcasecmp (options.input_type, "file") == 0) {
+    for (gint i = 0; i < options.input_count; i++) {
+      if (!file_exists (options.input_file_path[i])) {
+        g_printerr ("Invalid input file path: %s\n",
+            options.input_file_path[i]);
+        gst_app_context_free (&appctx, &options, config_file);
+        return -EINVAL;
+      }
+    }
+  }
+
+  if (!file_exists (options.detection_model_path)) {
+    g_printerr ("Invalid detection model path: %s\n",
+        options.detection_model_path);
+    gst_app_context_free (&appctx, &options, config_file);
+    return -EINVAL;
+  }
+
+  if (!file_exists (options.detection_labels_path)) {
+    g_printerr ("Invalid detection labels path: %s\n",
+        options.detection_labels_path);
+    gst_app_context_free (&appctx, &options, config_file);
+    return -EINVAL;
+  }
+
+  if (!file_exists (options.classification_model_path)) {
+    g_printerr ("Invalid classification model path: %s\n",
+        options.classification_model_path);
+    gst_app_context_free (&appctx, &options, config_file);
+    return -EINVAL;
+  }
+
+  if (!file_exists (options.classification_labels_path)) {
+    g_printerr ("Invalid classification labels path: %s\n",
+        options.classification_labels_path);
+    gst_app_context_free (&appctx, &options, config_file);
+    return -EINVAL;
+  }
+
+  g_print ("Detection model: %s\n", options.detection_model_path);
+  g_print ("Classification model: %s\n", options.classification_model_path);
+
+  gst_init (&argc, &argv);
+
+  pipeline = gst_pipeline_new (app_name);
+  if (!pipeline) {
+    g_printerr ("ERROR: failed to create pipeline.\n");
+    gst_app_context_free (&appctx, &options, config_file);
+    return -1;
+  }
+  appctx.pipeline = pipeline;
+
+  /* Build all configured RTSP/MP4 processing chains. */
+  ret = create_pipe (&appctx, &options, htp_count);
+  if (!ret) {
+    g_printerr ("ERROR: failed to create GST pipe.\n");
+    gst_app_context_free (&appctx, &options, config_file);
+    return -1;
+  }
+
+  if ((mloop = g_main_loop_new (NULL, FALSE)) == NULL) {
+    g_printerr ("ERROR: Failed to create Main loop!\n");
+    gst_app_context_free (&appctx, &options, config_file);
+    return -1;
+  }
+  appctx.mloop = mloop;
+
+  if ((bus = gst_pipeline_get_bus (GST_PIPELINE (pipeline))) == NULL) {
+    g_printerr ("ERROR: Failed to retrieve pipeline bus!\n");
+    gst_app_context_free (&appctx, &options, config_file);
+    return -1;
+  }
+
+  gst_bus_add_signal_watch (bus);
+  g_signal_connect (bus, "message::state-changed",
+      G_CALLBACK (state_changed_cb), pipeline);
+  g_signal_connect (bus, "message::error", G_CALLBACK (error_cb), mloop);
+  g_signal_connect (bus, "message::warning", G_CALLBACK (warning_cb), mloop);
+  g_signal_connect (bus, "message::eos", G_CALLBACK (eos_cb), mloop);
+  gst_object_unref (bus);
+
+  intrpt_watch_id =
+      g_unix_signal_add (SIGINT, handle_interrupt_signal, &appctx);
+
+  g_print ("Set pipeline to PAUSED state ...\n");
+  switch (gst_element_set_state (pipeline, GST_STATE_PAUSED)) {
+    case GST_STATE_CHANGE_FAILURE:
+      g_printerr ("ERROR: Failed to transition to PAUSED state!\n");
+      goto error;
+    case GST_STATE_CHANGE_NO_PREROLL:
+      g_print ("Pipeline is live and does not need PREROLL.\n");
+      break;
+    case GST_STATE_CHANGE_ASYNC:
+      g_print ("Pipeline is PREROLLING ...\n");
+      break;
+    case GST_STATE_CHANGE_SUCCESS:
+      g_print ("Pipeline state change was successful\n");
+      break;
+  }
+
+  /* The pipeline is live; run until interrupted or a bus callback stops it. */
+  g_main_loop_run (mloop);
+
+error:
+  if (intrpt_watch_id)
+    g_source_remove (intrpt_watch_id);
+
+  g_print ("Set pipeline to NULL state ...\n");
+  gst_element_set_state (pipeline, GST_STATE_NULL);
+
+  g_print ("Destroy pipeline\n");
+  gst_app_context_free (&appctx, &options, config_file);
+
+  g_print ("gst_deinit\n");
+  gst_deinit ();
+
+  return 0;
+}
