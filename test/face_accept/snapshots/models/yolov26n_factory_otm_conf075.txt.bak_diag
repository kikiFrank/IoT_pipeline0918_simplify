[model]
model_id=yolov26n_factory_otm
name=YOLOv26n OTM 9-Class Detector (start6 conf=0.75)
framework=qnn
backend=htp
model_path=../data/models/yolo26_otm_w8a8_input_u8_output_fp16.bin
labels_path=../config_snapshots/demo_2stage_yolo_serial/labels/yolov26n_factory_labels.json
batch=1

[input]
name=images
layout=NHWC
width=640
height=640
channels=3
dtype=uint8_or_float_runtime_checked

[preprocess]
type=yolov26n_letterbox
converter=qtimlvconverter
image_disposition=centre
subpixel_layout=reverse
mean=
sigma=
output_tensor_type=runtime_inferred

[output]
name=boxes,scores
shape=1,4,8400|1,9,8400
format=cxcywh|class_major_sigmoid
dtype=float16
class_count=9

[postprocess]
type=yolov26n_e2e
plugin=qtimlpostprocess_roi
module=yolo26-otm
confidence_thresh=0.75
results=50
coordinate_restore=letterbox
person_only_boxes=false
hide_person_label=false
